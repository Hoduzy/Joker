{
  "dahye": [
    { "level": 2, "title": "방송실 열쇠", "lines": [
      { "bg": "broadcast", "s": "", "t": "다들 돌아간 방송실. 다혜 부장이 혼자 큐시트를 고치고 있었다." },
      { "s": "dahye", "e": "neutral", "t": "…왜 아직 있어. 문 잠글 거야." },
      { "s": "me", "t": "부장님도 아직 계시잖아요." },
      { "s": "dahye", "e": "angry", "t": "나는 부장이니까 그렇고." },
      { "s": "dahye", "e": "neutral", "t": "…이 장면, 몇 번째일까. 늦게까지 남는 신입이라니. 처음이야." },
      { "choice": [
        { "t": "\"같이 정리하고 가요.\"", "xp": { "dahye": 25 }, "then": [
          { "s": "dahye", "e": "blush", "t": "…마음대로 해. 대신 큐시트 순서 바꾸면 죽어." }
        ] },
        { "t": "\"열쇠는 제가 잠글게요.\"", "xp": { "dahye": 15 }, "then": [
          { "s": "dahye", "e": "surprised", "t": "열쇠를 남한테 맡기는 건… 처음인데." }
        ] }
      ] },
      { "s": "", "t": "복도 불을 끄고 나오는 길, 부장이 아주 작게 말했다. \"…수고했어.\"" }
    ] },
    { "level": 4, "title": "하굣길 편의점", "lines": [
      { "bg": "street", "s": "dahye", "e": "neutral", "t": "…편의점 들를 거야. 따라오든 말든." },
      { "s": "", "t": "계산대 앞. 부장이 따뜻한 캔음료 두 개를 내려놓았다." },
      { "s": "dahye", "e": "blush", "t": "하나는… 실수로 두 개 집은 거야. 버리기 아까우니까 네가 마셔." },
      { "s": "me", "t": "제가 좋아하는 맛인데요?" },
      { "s": "dahye", "e": "angry", "t": "우, 우연이야! 삼백 번 넘게 봤으니까 아는 게 아니라!" },
      { "s": "dahye", "e": "surprised", "t": "…아." },
      { "choice": [
        { "t": "모른 척 \"우연이네요\"라고 웃는다", "xp": { "dahye": 25 }, "then": [
          { "s": "dahye", "e": "blush", "t": "…그래. 우연이야. 고마워, 모른 척해 줘서." }
        ] },
        { "t": "\"다음엔 제가 부장님 거 사 올게요.\"", "xp": { "dahye": 20 }, "then": [
          { "s": "dahye", "e": "blush", "t": "…블랙커피. 설탕 넣으면 안 마셔." }
        ] }
      ] }
    ] },
    { "level": 6, "title": "옥상의 노트", "lines": [
      { "bg": "rooftop", "s": "", "t": "송신탑 아래, 부장이 낡은 노트를 펼쳐 놓고 있었다. 페이지마다 바를 정(正) 자가 빼곡했다." },
      { "s": "dahye", "e": "neutral", "t": "루프 기록이야. 매번 뭘 했는지, 몇 명이 들었는지, 왜 실패했는지." },
      { "s": "dahye", "e": "sad", "t": "처음엔 글씨가 반듯했는데, 뒤로 갈수록 엉망이지. …지쳤던 거야." },
      { "s": "me", "t": "이번 페이지는 아직 비어 있네요." },
      { "s": "dahye", "e": "neutral", "t": "응. 이번엔… 쓰고 싶은 게 달라서. 실패 기록 말고." },
      { "choice": [
        { "t": "\"제가 첫 줄을 써도 돼요?\"", "xp": { "dahye": 30 }, "then": [
          { "s": "", "t": "나는 빈 페이지에 적었다. 『이번엔 둘이 기억함.』" },
          { "s": "dahye", "e": "blush", "t": "…글씨 엉망이야. 그래도… 지우진 않을게." }
        ] },
        { "t": "말없이 옆에 앉는다", "xp": { "dahye": 20 }, "then": [
          { "s": "dahye", "e": "smile", "t": "…가끔은 이렇게 아무 말 없는 게 제일 편해." }
        ] }
      ] }
    ] },
    { "level": 8, "title": "비 오는 날 우산", "lines": [
      { "bg": "hallway", "s": "", "t": "갑작스러운 소나기. 현관에서 부장이 우산도 없이 하늘을 올려다보고 있었다." },
      { "s": "dahye", "e": "neutral", "t": "…이 비, 원래는 안 오는 비야. 루프마다 날씨가 똑같았거든." },
      { "s": "dahye", "e": "surprised", "t": "처음으로 '모르는 일'이 생겼어. 이상하지. 무서운데… 조금 설레." },
      { "s": "me", "t": "우산, 같이 써요." },
      { "s": "dahye", "e": "blush", "t": "…좁잖아. 어깨 젖어." },
      { "s": "dahye", "e": "blush", "t": "…그래도, 같이 써." },
      { "choice": [
        { "t": "우산을 부장 쪽으로 기울인다", "xp": { "dahye": 30 }, "then": [
          { "s": "dahye", "e": "angry", "t": "너 어깨 다 젖잖아, 바보!" },
          { "s": "dahye", "e": "blush", "t": "…내일 감기 걸리면, 내가 죽 사 갈게." }
        ] },
        { "t": "\"모르는 일, 앞으로 더 많아질 거예요.\"", "xp": { "dahye": 25 }, "then": [
          { "s": "dahye", "e": "smile", "t": "…응. 너랑이면, 모르는 내일도 괜찮을 것 같아." }
        ] }
      ] }
    ] },
    { "level": 10, "title": "새벽의 약속", "lines": [
      { "bg": "rooftop", "s": "", "t": "밤샘 방송이 끝난 새벽. 옥상의 공기는 차갑고 맑았다." },
      { "s": "dahye", "e": "neutral", "t": "삼백 마흔두 번 동안, 새벽은 늘 '끝나기 직전'이었어." },
      { "s": "dahye", "e": "smile", "t": "근데 지금은 그냥… 아침이 오는 시간이네." },
      { "s": "dahye", "e": "blush", "t": "신입. 아니… 이제 그렇게 부르면 안 되겠지." },
      { "s": "dahye", "e": "blush", "t": "다음 루프에서도 널 찾아낼 거야. …아니, 다음 루프 같은 건 없게 하자. 같이." },
      { "choice": [
        { "t": "\"약속해요. 매일 아침, 같이 봐요.\"", "xp": { "dahye": 40 }, "then": [
          { "s": "dahye", "e": "smile", "t": "…약속이야. 이번엔 내가 먼저 기억할게." }
        ] },
        { "t": "새끼손가락을 내민다", "xp": { "dahye": 40 }, "then": [
          { "s": "dahye", "e": "blush", "t": "…애도 아니고. …걸어 줄게. 특별히." }
        ] }
      ] },
      { "cg": "dahye", "caption": "새벽 옥상, 처음으로 웃는 다혜" }
    ] }
  ],
  "mirae": [
    { "level": 2, "title": "납땜 강의", "lines": [
      { "bg": "broadcast", "s": "mirae", "e": "neutral", "t": "…인두 잡아 봐. 거기 말고. 손잡이." },
      { "s": "mirae", "e": "smile", "t": "온도는 350도. 납은 인두에 대지 말고 부품 다리에. 열이 전해지면 납이 스스로 흘러들어가. 그게 좋은 납땜이야." },
      { "s": "me", "t": "…동그랗게 됐어!" },
      { "s": "mirae", "e": "surprised", "t": "첫 번째인데 이렇게 예쁜 필렛은 처음 봐." },
      { "choice": [
        { "t": "\"선생님이 좋아서 그래.\"", "xp": { "mirae": 25 }, "then": [
          { "s": "mirae", "e": "blush", "t": "…선생님 아니야. 근데 또 가르쳐 줄게." }
        ] },
        { "t": "\"하나 더 해 볼래.\"", "xp": { "mirae": 20 }, "then": [
          { "s": "mirae", "e": "smile", "t": "응. 기판 하나 통째로 줄게. 오늘 밤 새도 돼." }
        ] }
      ] }
    ] },
    { "level": 4, "title": "새 헤드폰", "lines": [
      { "bg": "broadcast", "s": "mirae", "e": "neutral", "t": "…이거 써 봐. 내가 개조한 모니터 헤드폰." },
      { "s": "", "t": "귀를 덮는 순간, 방송실의 모든 소리가 사라지고 미래의 목소리만 또렷하게 들렸다." },
      { "s": "mirae", "e": "smile", "t": "들려? 지금 내 마이크랑 직결이야. 다른 소리는 다 잘랐어." },
      { "s": "mirae", "e": "blush", "t": "…그러니까 지금은, 내 목소리밖에 안 들리는 거야." },
      { "choice": [
        { "t": "\"계속 듣고 싶은 목소리야.\"", "xp": { "mirae": 30 }, "then": [
          { "s": "mirae", "e": "blush", "t": "………. 노이즈 끼었어. 내 쪽에. 심장 소리." }
        ] },
        { "t": "\"이거 진짜 대단하다!\"", "xp": { "mirae": 20 }, "then": [
          { "s": "mirae", "e": "smile", "t": "…응. 너 줄게. 원래 그러려고 만든 거야." }
        ] }
      ] }
    ] },
    { "level": 6, "title": "송신탑 수리", "lines": [
      { "bg": "rooftop", "s": "", "t": "강풍에 휘어진 안테나. 미래와 나는 해 질 녘 송신탑 꼭대기에 매달려 있었다." },
      { "s": "mirae", "e": "neutral", "t": "볼트 줘. 10밀리. …아니, 그거 12야." },
      { "s": "mirae", "e": "smile", "t": "있잖아, 내가 왜 이 탑을 만들었는지 말 안 했지." },
      { "s": "mirae", "e": "neutral", "t": "멀리 있는 사람한테 말을 걸고 싶었어. 얼굴 보고는… 말을 잘 못하니까. 전파로는 할 수 있을 것 같아서." },
      { "s": "mirae", "e": "blush", "t": "근데 요즘은 얼굴 보고도 말이 좀 나와. 너한테만." },
      { "choice": [
        { "t": "\"그럼 나한테 제일 먼저 말 걸어 줘.\"", "xp": { "mirae": 30 }, "then": [
          { "s": "mirae", "e": "blush", "t": "…이미 그러고 있어. 몰랐어?" }
        ] },
        { "t": "\"이 탑, 꼭 같이 지키자.\"", "xp": { "mirae": 25 }, "then": [
          { "s": "mirae", "e": "smile", "t": "응. 이 탑은 이제 우리 둘 거야. 설계도에 네 이름도 적을게." }
        ] }
      ] }
    ] },
    { "level": 8, "title": "고장 난 라디오", "lines": [
      { "bg": "broadcast", "s": "mirae", "e": "neutral", "t": "…오늘은 탑 말고 이거. 할아버지 라디오야." },
      { "s": "mirae", "e": "sad", "t": "어릴 때 이 라디오로 할아버지랑 밤마다 방송 들었어. 돌아가시고 나서 고장 났고." },
      { "s": "mirae", "e": "neutral", "t": "이거 고치려고 전자공학 공부 시작했어. 근데 아직 못 고쳤어. …고치면, 진짜 끝난 것 같아서." },
      { "choice": [
        { "t": "\"고치는 거, 옆에서 지켜봐도 돼?\"", "xp": { "mirae": 30 }, "then": [
          { "s": "", "t": "한 시간 뒤. 지지직— 낡은 스피커에서 우리 방송부의 심야 방송이 흘러나왔다." },
          { "s": "mirae", "e": "sad", "t": "…들려, 할아버지. 나 이제 방송 만드는 쪽이야." },
          { "s": "mirae", "e": "smile", "t": "…고마워. 혼자였으면 못 켰어." }
        ] },
        { "t": "\"안 고쳐도 괜찮아. 소중한 거니까.\"", "xp": { "mirae": 25 }, "then": [
          { "s": "mirae", "e": "smile", "t": "…그 말 듣고 나니까 고치고 싶어졌어. 이상하지." }
        ] }
      ] }
    ] },
    { "level": 10, "title": "둘만의 주파수", "lines": [
      { "bg": "rooftop", "s": "", "t": "별이 쏟아지는 밤, 송신탑 아래. 미래가 작은 수신기 두 대를 내밀었다." },
      { "s": "mirae", "e": "neutral", "t": "탑에 채널 하나 추가했어. 98.7. 아무도 모르는 주파수." },
      { "s": "mirae", "e": "blush", "t": "여기로 보내는 건… 너한테만 가." },
      { "s": "", "t": "수신기에서 미래의 목소리가 흘러나왔다. 바로 옆에 있는데도, 이상하게 더 가까이." },
      { "s": "mirae", "e": "blush", "t": "『…좋아해. 이 탑만큼. 아니, 그보다 조금 더.』" },
      { "choice": [
        { "t": "수신기에 대고 대답한다", "xp": { "mirae": 40 }, "then": [
          { "s": "mirae", "e": "blush", "t": "…수신 상태 최고. 잡음 하나도 없어." }
        ] },
        { "t": "수신기 말고 직접 말한다", "xp": { "mirae": 40 }, "then": [
          { "s": "mirae", "e": "surprised", "t": "………직접은 반칙이야. 출력이 너무 세." }
        ] }
      ] },
      { "cg": "mirae", "caption": "별빛 아래, 둘만의 주파수" }
    ] }
  ],
  "yuri": [
    { "level": 2, "title": "등굣길 소꿉친구", "lines": [
      { "bg": "street", "s": "yuri", "e": "smile", "t": "야! 늦잠 잤지? 머리 뻗친 거 봐~" },
      { "s": "yuri", "e": "smile", "t": "자, 토스트. 너 아침 안 먹는 거 다 알거든. 십 년째 보고 있는데." },
      { "s": "me", "t": "…고마워. 근데 매일 챙겨 줄 필요 없어." },
      { "s": "yuri", "e": "angry", "t": "필요 있어! 내가 하고 싶어서 하는 거거든!" },
      { "choice": [
        { "t": "\"그럼 내일은 내가 너 거 챙길게.\"", "xp": { "yuri": 25 }, "then": [
          { "s": "yuri", "e": "blush", "t": "…진짜? 딸기우유! 잊으면 안 돼!" }
        ] },
        { "t": "머리를 쓰다듬는다", "xp": { "yuri": 20 }, "then": [
          { "s": "yuri", "e": "blush", "t": "애, 애 취급하지 마! …조금만 더 해도 돼." }
        ] }
      ] }
    ] },
    { "level": 4, "title": "옛날 사진", "lines": [
      { "bg": "classroom", "s": "yuri", "e": "smile", "t": "이거 봐! 유치원 때 사진! 너 울고 있다~ 내가 달래 주는 중이고." },
      { "s": "yuri", "e": "smile", "t": "넌 기억 안 나지? 그때 네가 그랬어. '유리는 맨날 웃으니까 좋아.'" },
      { "s": "yuri", "e": "sad", "t": "…그래서 나 그 뒤로 계속 웃었어. 슬퍼도." },
      { "choice": [
        { "t": "\"이제 내 앞에선 안 웃어도 돼.\"", "xp": { "yuri": 30 }, "then": [
          { "s": "yuri", "e": "sad", "t": "………그런 말 하면, 진짜 울어 버린다?" },
          { "s": "yuri", "e": "smile", "t": "…헤헤. 그래도 너 앞에선 웃을래. 진짜로 웃게 되니까." }
        ] },
        { "t": "\"그 사진, 나도 한 장 줘.\"", "xp": { "yuri": 20 }, "then": [
          { "s": "yuri", "e": "blush", "t": "지갑에 넣고 다닐 거야? …나도 그러고 있거든." }
        ] }
      ] }
    ] },
    { "level": 6, "title": "말랑이의 비밀", "lines": [
      { "bg": "street", "s": "yuri", "e": "neutral", "t": "있잖아, 말랑이 키링… 사실 두 개 세트야." },
      { "s": "yuri", "e": "blush", "t": "초등학교 때 문구점에서 샀는데, 하나는 너 주려고 했어. 근데 못 줬어. 칠 년 동안." },
      { "s": "yuri", "e": "blush", "t": "…지금 줘도 돼?" },
      { "choice": [
        { "t": "\"가방에 바로 달게.\"", "xp": { "yuri": 30 }, "then": [
          { "s": "yuri", "e": "smile", "t": "커플 키링이다~! …아, 아니, 세트 키링! 세트!" }
        ] },
        { "t": "\"칠 년이나 기다렸어?\"", "xp": { "yuri": 25 }, "then": [
          { "s": "yuri", "e": "blush", "t": "기다린 거 아니야! …그냥, 타이밍이 없었던 거야." }
        ] }
      ] }
    ] },
    { "level": 8, "title": "숨긴 것", "lines": [
      { "bg": "rooftop", "s": "yuri", "e": "sad", "t": "그 신호, 내가 먼저 들었다고 했잖아. 그날 밤 진짜 무서웠어." },
      { "s": "yuri", "e": "sad", "t": "'그 애가 없으면 이번에도 안 돼'라는 말이… 꼭 네가 사라질 것 같다는 말로 들렸거든." },
      { "s": "yuri", "e": "neutral", "t": "그래서 방송부에 데려간 거야. 세계 때문이 아니라… 네 옆에 있고 싶어서." },
